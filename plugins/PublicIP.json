{
  "id": "public_ip_info",
  "meta": {
    "name": "公网IP显示",
    "name_en": "Public IP",
    "version": "1.0",
    "author": "LiteMonitor",
    "description": "公网IP插件，获取当前网络的公网IPv4地址",
    "description_en": "Public IP plugin, gets the public IPv4 addresses of the current network"
  },
  "inputs": [],
  "execution": {
    "type": "chain",
    "interval": 600,
    "steps": [
      {
        "id": "get_direct_ip",
        "url": "https://whois.pconline.com.cn/ipJson.jsp?json=true",
        "response_encoding": "gbk",
        "extract": {
          "direct_ip": "ip",
          "direct_addr_raw": "addr",
          "direct_addr_pro": "pro",
          "direct_addr_city": "city",
          "direct_addr_region": "region"
        },
        "process": [
          {
            "var": "isp_name",
            "source": "direct_addr_raw",
            "function": "regex_replace",
            "pattern": ".*\\s([\\u4e00-\\u9fa5]+)[A-Za-z]*.*",
            "to": "$1"
          }
        ]
      },
      {
        "id": "get_direct_latency",
        "url": "http://wifi.vivo.com.cn/generate_204",
        "cache_minutes": 0,
        "process": [
          {
            "var": "direct_latency",
            "source": "__latency__",
            "function": "resolve_template"
          },
          {
            "var": "direct_latency_color",
            "source": "__latency__",
            "function": "threshold_switch",
            "value_map": {
              "0": "0",
              "200": "1",
              "500": "2"
            }
          }
        ]
      },
      {
        "id": "get_proxy_ip",
        "url": "https://api.ipapi.is/",
        "response_encoding": "gbk",
        "extract": {
          "proxy_ip": "ip",
          "proxy_ip_desc_raw": "company.name",
          "proxy_ip_country": "location.country",
          "proxy_ip_state": "location.state",
          "proxy_ip_city": "location.city"
        },
        "process": [
          {
            "var": "proxy_ip_desc",
            "source": "proxy_ip_desc_raw",
            "function": "regex_replace",
            "pattern": "([^,]+).*",
            "to": "$1"
          }
        ]
      },
      {
        "id": "get_proxy_latency",
        "url": "https://www.google.com/generate_204?dummy={{__latency__}}",
        "cache_minutes": 0,
        "process": [
          {
            "var": "proxy_latency",
            "source": "__latency__",
            "function": "resolve_template"
          },
          {
            "var": "proxy_latency_color",
            "source": "__latency__",
            "function": "threshold_switch",
            "value_map": {
              "0": "0",
              "200": "1",
              "500": "2"
            }
          }
        ]
      }
    ]
  },
  "outputs": [
    {
      "key": "direct_ip",
      "label": "直连IP",
      "label_en": "Direct IP",
      "short_label": " ",
      "format_val": "{{direct_ip}} [{{isp_name}}]",
      "unit": ""
    },
    {
      "key": "direct_addr",
      "label": "直连🌏",
      "label_en": "Direct 📍",
      "short_label": " ",
      "format_val": "{{direct_addr_pro}}, {{direct_addr_city}}, {{direct_addr_region}}",
      "unit": ""
    },
    {
      "key": "direct_latency",
      "label": "直连⏳",
      "label_en": "Direct ⏳",
      "short_label": " ",
      "format_val": "{{direct_latency}} ms",
      "unit": "",
      "color": "{{direct_latency_color}}"
    },
    {
      "key": "proxy_ip",
      "label": "代理IP",
      "label_en": "Proxy IP",
      "short_label": " ",
      "format_val": "{{proxy_ip}} [{{proxy_ip_desc}}]",
      "unit": ""
    },
    {
      "key": "proxy_addr",
      "label": "代理🌏",
      "label_en": "Proxy 📍",
      "short_label": " ",
      "format_val": "{{proxy_ip_country}}, {{proxy_ip_state}}, {{proxy_ip_city}}",
      "unit": ""
    },
    {
      "key": "proxy_latency",
      "label": "代理⏳",
      "label_en": "Proxy ⏳",
      "short_label": " ",
      "format_val": "{{proxy_latency}} ms",
      "unit": "",
      "color": "{{proxy_latency_color}}"
    }
  ]
}
