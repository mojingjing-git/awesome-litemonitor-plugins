        "method": "GET",
        "headers": {
          "Authorization": "Bearer {{api_key}}"
        },
        "response_format": "json",
        "extract": {
          "interval_pct": "model_remains[0].current_interval_remaining_percent",
          "weekly_pct": "model_remains[0].current_weekly_remaining_percent",
          "remains_time": "model_remains[0].remains_time"
        },
