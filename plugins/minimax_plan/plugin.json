    "name": "MiniMax 余量",
    "name_en": "MiniMax Quota",
    "version": "1.0",
    "author": "mojingjing-git",
    "description": "查询 MiniMax Token Plan 5小时/周窗口剩余配额",
    "description_en": "Query the remaining quota of the MiniMax Token Plan 5-hour and weekly windows"
  },
  "inputs": [
    {
      "key": "api_key",
      "label": "API Key",
      "type": "text",
      "default": "",
      "placeholder": "sk-cp-...",
      "scope": "global",
      "label_en": "API Key"
    }
  ],
